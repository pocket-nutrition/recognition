# Pocket Nutrition recognition server configuration
# Copy this file to .env and adjust as needed
# cp .env.example .env
#
# The server reads real environment variables only: it does not load .env by itself.
# Export them (set -a; . ./.env; set +a) or pass the file to Docker (--env-file .env).
# Keep every comment on its own line: Docker's --env-file does not strip trailing comments.
# Apart from RECOGNITION_PIPELINE, every value below is the built-in default, so any line you do not need can be deleted.
# Do not delete RECOGNITION_PIPELINE: when it is missing the server starts the simulator instead of waiting for a worker.

# === Authentication (set at least one of the first two, or the server refuses to start) ===

# Shared key for the phone-facing routes (Authorization: Bearer <key>). Keep it secret; generate one with openssl rand -hex 32
RECOGNITION_API_KEY=

# Comma-separated vault hostnames whose write-only drop tokens authenticate a capture (e.g. vault.pocketnutrition.org)
RECOGNITION_TRUSTED_VAULTS=

# === Pipeline ===

# "worker": jobs wait for a worker on a Mac to pull them (what a deployed server runs)
# "simulator": returns a fixed sample result, for development and tests only
RECOGNITION_PIPELINE=worker

# Secret for the /worker/* routes. Required in worker mode: the server refuses to start without it. 16+ characters, different from the API key (openssl rand -hex 32)
RECOGNITION_WORKER_KEY=

# Seconds a worker may hold a job before it is requeued (each progress call extends the lease)
RECOGNITION_LEASE_S=120

# Times a job is handed to a worker before its ticket fails with "worker did not finish the job"
RECOGNITION_MAX_ATTEMPTS=3

# === Limits ===

# Worker mode: most jobs waiting for or held by a worker; beyond this POST /captures answers 503
RECOGNITION_MAX_QUEUED=50

# Worker mode: most bytes of recordings and photos held in memory for workers (200 MiB); beyond this: 503
RECOGNITION_MAX_QUEUED_BYTES=209715200

# Largest accepted recording or photo, in bytes (10 MiB); larger uploads get 413
RECOGNITION_MAX_AUDIO_BYTES=10485760

# Longest long-poll wait in seconds (?wait=N) for phones and workers; keep it below your reverse proxy's idle timeout
RECOGNITION_MAX_WAIT_S=25

# How long a mode=sync request waits for the result, in seconds, before answering 202
RECOGNITION_SYNC_TIMEOUT_S=30

# === Ticket lifetime ===

# Seconds before a ticket expires (172800 = 48 h)
RECOGNITION_TICKET_TTL_S=172800

# Seconds an expired ticket is remembered so clients can tell "expired" from "unknown" (604800 = 7 days)
RECOGNITION_TOMBSTONE_TTL_S=604800

# Seconds between sweeps that purge expired tickets and requeue jobs whose worker went silent
RECOGNITION_SWEEP_INTERVAL_S=30

# === Simulator pipeline (development and tests only; ignored in worker mode) ===

# Seconds before the sample result is ready when the request does not set simulate_delay_s
RECOGNITION_DEFAULT_DELAY_S=6

# Upper bound in seconds for the simulated delay, whatever the request asks
RECOGNITION_MAX_DELAY_S=120

# === Vault delivery ===

# Seconds before a request to a vault times out (GET /v1/me to check a drop token; PUT /v1/drop in simulator mode, where this server deposits)
RECOGNITION_VAULT_TIMEOUT_S=10

# Simulator mode only (in worker mode the worker deposits): seconds to wait between retries of a failed vault deposit, as a JSON list (three values = three retries)
RECOGNITION_VAULT_RETRY_DELAYS_S=[1,5,30]

# DEVELOPMENT ONLY: accept http and non-public vault URLs, which switches off SSRF protection. Never in production
RECOGNITION_VAULT_ALLOW_INSECURE=false
